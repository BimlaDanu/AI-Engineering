# Sign-in configuration — COPY THIS FILE, DO NOT EDIT IT
#
#     cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#
# `.streamlit/secrets.toml` is git-ignored and must stay that way: the values below
# are credentials. This example file is committed and contains none.
#
# Everything here is OPTIONAL. With no `secrets.toml` at all the application runs
# exactly as it does today and every visitor is a guest on the free model — see
# `src/ui/access.py`. The sign-in button is not drawn when this section is absent,
# because a button that raises when pressed is worse than no button.
#
# Needs one package the base install does not carry:
#
#     uv add authlib
#
# ---------------------------------------------------------------------------
# How to fill this in with Google as the provider (about ten minutes, free)
#
#  1. console.cloud.google.com -> APIs & Services -> OAuth consent screen.
#     External, fill in the app name and your email, save.
#  2. Credentials -> Create credentials -> OAuth client ID -> Web application.
#  3. Authorised redirect URI — add BOTH of these, exactly:
#        http://localhost:8501/oauth2callback
#        https://<your-app>.streamlit.app/oauth2callback
#     The path `/oauth2callback` is Streamlit's, not yours. A mismatch here is the
#     single commonest cause of "redirect_uri_mismatch" and it is worth checking
#     character by character before assuming anything else is wrong.
#  4. Copy the client ID and client secret into the two fields below.
#  5. `cookie_secret` is yours to invent — any long random string. It signs the
#     session cookie, so changing it signs everybody out.
#
# Deploying to Streamlit Community Cloud: paste the whole `[auth]` section into
# the app's Settings -> Secrets box instead of committing a file, and set
# `redirect_uri` to the deployed URL.
# ---------------------------------------------------------------------------

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "replace-me-with-a-long-random-string"
client_id = "replace-me.apps.googleusercontent.com"
client_secret = "replace-me"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
