PROJECTS-IDEAS-CAPSTONE/
ML-AI-Assistant/
EXTRAS/
Templates/
Files_TEST/
flagged/
PROMPT-WORKING/

# Generated state, in its own top-level folders beside data/. Everything in data/
# is committed, by rule — anything the machine produces lives out here instead, so
# "is this committed?" is answered by the path, not by an ignore rule.
# See data/README.md.
#
# Chroma vector store (make ingest). The glob covers the copies a reindex leaves
# behind -- chroma_db.discarded/ is 14 MB and `chroma_db/` alone does not match it.
chroma_db/
chroma_db.*/
# conversation state (SQLite, agent/checkpointing.py)
.checkpoints/
# what the agent remembers: turns and ratings (JSONL, agent/memory.py). Never
# committed — it is one user's conversation, and it is theirs to delete.
.memory/

# Optional generated data/models (uncomment if needed)
models/
outputs/
Presentation_Capstone/
TASKS/

# Build artifacts
build/
dist/
*.egg-info/

# Jupyter
.ipynb_checkpoints/

# Read-only prior code kept locally for reference. Not part of this project:
# nothing here is importable and nothing here ships.
#
# Anchored with a leading slash, and that anchor is load-bearing: unanchored,
# `reference/` matches a directory of that name at ANY depth, which silently
# excluded src/physics/reference/ -- the sealed exact solvers the whole
# experiment is graded against -- from every push.
/reference/

# Promoted knowledge base — fetched from external sources, screened, regenerable
promoted/
