# Template for a deployment. Copy to .streamlit/secrets.toml and fill in, or
# paste the same keys into Settings → Secrets on Streamlit Community Cloud.
#
# The real secrets.toml is git-ignored. This example is not, so it must never
# hold a working key: every value below is a placeholder.
#
# Running locally needs none of this. A key in .env grants access with no gate.
# auth.py reads secrets first, then the environment, so any key here can also
# be set as an environment variable instead.

# Pays for the free trial, so it is spent on behalf of visitors who have no key
# of their own. Omit it and the trial is simply unavailable; visitors can still
# paste their own key. Get one at https://openrouter.ai/keys.
OPENROUTER_API_KEY = "sk-or-v1-REPLACE_ME"

# Whether the "start the free trial" option appears at all. Default: true.
ALLOW_FREE_TRIAL = "true"

# How many requests one anonymous session may spend on the key above. The
# counter lives in session state, so a fresh tab gets a fresh allowance: treat
# this as a demo budget, not a hard limit, and keep it low.
TRIAL_REQUESTS = "10"

# The same allowance for a signed-in visitor.
SIGNED_IN_REQUESTS = "50"

# Forces the login screen even when a key is present in .env. Worth setting
# once locally to see what a visitor sees before deploying.
# REQUIRE_LOGIN = "false"

# ─────────────────────────────────────────────────────────────────────────────
# Google sign-in, via st.login() (OIDC, so Google holds the credentials and
# this app never sees a password).
#
# Needs Streamlit 1.42 or newer and this project pins 1.37.1, so leave this
# commented for now. To enable it: raise the streamlit pin in pyproject.toml,
# run `uv lock && uv sync`, then uncomment the block. auth.py detects it at
# runtime and shows the button on its own, with no code change.
#
# redirect_uri must match the one registered with the provider exactly, and
# cookie_secret is a long random string of your own making.
#
# [auth]
# redirect_uri = "https://YOUR-APP.streamlit.app/oauth2callback"
# cookie_secret = "REPLACE_ME_WITH_A_LONG_RANDOM_STRING"
# client_id = "REPLACE_ME.apps.googleusercontent.com"
# client_secret = "REPLACE_ME"
# server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
